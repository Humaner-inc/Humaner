# =============================================================================
# HUMANER INTELLIGENCE
# =============================================================================

# Humaner Cloud origin 
HUMANER_API_BASE_URL=

# Agent public ID (mandatory to use Intelligence)
HUMANER_AGENT_ID=

# Bearer token for POST /api/v1/intelligence/*
# Create in Dashboard → Environment → API key (shown once at creation)
HUMANER_API_KEY=

# =============================================================================
# LLM PROVIDER (only exemples)
# =============================================================================

# --- Google AI Studio / Gemini ---
# Native Gemini via Google's OpenAI-compatible endpoint.
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_google_ai_studio_key_here
# GEMINI_API_KEY=your_gemini_key_here  # alias for GOOGLE_API_KEY
# Optional base URL override (default: Google's OpenAI-compatible endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Anthropic Claude ---
# Get your key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Nous Research Hermes (OpenAI-compatible) ---
# Get your key at: https://nousresearch.com/
# NOUS_API_KEY=your_nous_key_here
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
