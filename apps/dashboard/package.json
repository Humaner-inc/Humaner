{
  "name": "@humaner/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:turbo": "next dev --turbo",
    "dev:email": "email dev",
    "build": "next build",
    "start": "next start --port 3001",
    "analyze": "BUNDLE_ANALYZE=both next build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier:fix": "prettier --write .",
    "eslint:fix": "npx eslint --fix .",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:fix-enums": "dotenv -e .env.local -- prisma db execute --file prisma/sql/rename-character-bold-to-sharp.sql && dotenv -e .env.local -- prisma db execute --file prisma/sql/rename-character-sharp-to-efficient.sql && dotenv -e .env.local -- prisma db execute --file prisma/sql/widget-dock-position-and-icons.sql",
    "db:push": "dotenv -e .env.local -- prisma db execute --file prisma/sql/rename-character-bold-to-sharp.sql && dotenv -e .env.local -- prisma db execute --file prisma/sql/rename-character-sharp-to-efficient.sql && dotenv -e .env.local -- prisma db execute --file prisma/sql/widget-dock-position-and-icons.sql && dotenv -e .env.local -- prisma db execute --file prisma/sql/phase3-gap-clustering.sql && dotenv -e .env.local -- prisma db push && dotenv -e .env.local -- prisma db execute --file prisma/sql/phase3-gap-clustering.sql",
    "db:phase3": "dotenv -e .env.local -- prisma db execute --file prisma/sql/phase3-gap-clustering.sql",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:execute:pgvector": "pnpm db:phase3",
    "imap:idle": "dotenv -e .env.local -- node --import ./scripts/register-server-only-stub.mjs --import tsx scripts/imap-idle-worker.ts",
    "imap:idle:prod": "node --import ./scripts/register-server-only-stub.mjs --import tsx scripts/imap-idle-worker.ts",
    "postinstall": "patch-package && node scripts/prisma-generate.mjs"
  },
