  bodyHtml          String?              @db.Text
  sentAt            DateTime
  createdAt         DateTime             @default(now())

  @@unique([threadId, providerMessageId], map: "UQ_MailMessage_thread_providerMessage")
  @@index([threadId, sentAt], map: "IX_MailMessage_thread_sentAt")
}

/// Internal-only collaboration note — never sent to the customer.
model MailThreadNote {
  id        String     @id(map: "PK_MailThreadNote") @default(uuid()) @db.Uuid
  threadId  String     @db.Uuid
  thread    MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId  String     @db.Uuid
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([threadId], map: "IX_MailThreadNote_threadId")
  @@index([authorId], map: "IX_MailThreadNote_authorId")
}

model KnowledgeSourceDraft {
  id               String      @id(map: "PK_KnowledgeSourceDraft") @default(uuid()) @db.Uuid
  agentId          String      @db.Uuid
  agent            Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title            String      @db.VarChar(255)
  content          String      @db.Text
  sourceMessageIds String[]
  status           DraftStatus @default(PENDING_REVIEW)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([agentId], map: "IX_KnowledgeSourceDraft_agentId")
}

// ---- Agent Training & Intelligence ---- //

enum PlatformChunkSource {
  SYNTHETIC    @map("synthetic")
  CURATED_REAL @map("curatedReal")
}

enum EvalRunType {
  MANUAL           @map("manual")
  AUTO_NEW_SOURCE  @map("autoNewSource")
  AUTO_CONFIG      @map("autoConfig")
  AUTO_WEEKLY      @map("autoWeekly")
  PLATFORM         @map("platform")
  VERTICAL_RELEASE @map("verticalRelease")
}

enum QuestionCategory {
  COMMON     @map("common")
  EDGE       @map("edge")
  TRAP       @map("trap")
  ESCALATION @map("escalation")
}

enum KnowledgeGapStatus {
  PENDING   @map("pending")
  RESOLVED  @map("resolved")
  DISMISSED @map("dismissed")
}

enum PlatformGapStatus {
  PENDING  @map("pending")
  IN_EVAL  @map("inEval")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

model PlatformChunk {
  id           String              @id(map: "PK_PlatformChunk") @default(cuid())
  industry     IndustryType
  question     String              @db.Text
  content      String              @db.Text
  tokenCount   Int
  source       PlatformChunkSource @default(SYNTHETIC)
  qualityScore Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([industry], map: "IX_PlatformChunk_industry")
}

model VerticalRelease {
  id             String       @id(map: "PK_VerticalRelease") @default(cuid())
  industry       IndustryType
  version        String
  certified      Boolean      @default(false)
  certificate    Json
  personaPreset  Json
  intentTaxonomy Json
  routingConfig  Json
  chunkCount     Int          @default(0)
  promotedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([industry, version], map: "UQ_VerticalRelease_industry_version")
  @@index([industry], map: "IX_VerticalRelease_industry")
}

model AgentEvalRun {
  id                 String        @id(map: "PK_AgentEvalRun") @default(uuid()) @db.Uuid
  agentId            String?       @db.Uuid
  industry           IndustryType?
  totalQuestions     Int
  passed             Int
  accuracyAvg        Float
  personaAvg         Float
  helpfulnessAvg     Float
  hallucinationCount Int
  runType            EvalRunType   @default(MANUAL)
  createdAt          DateTime      @default(now())

  agent   Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  results EvalResult[]

  @@index([agentId], map: "IX_AgentEvalRun_agentId")
  @@index([industry], map: "IX_AgentEvalRun_industry")
}

model EvalResult {
  id            String            @id(map: "PK_EvalResult") @default(uuid()) @db.Uuid
  runId         String            @db.Uuid
  question      String            @db.Text
  questionType  QuestionCategory?
  response      String            @db.Text
  accuracy      Float
  persona       Float
  helpfulness   Float
  hallucination Float
  passed        Boolean
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())

  run AgentEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([runId], map: "IX_EvalResult_runId")
}

model KnowledgeGap {
  id              String             @id(map: "PK_KnowledgeGap") @default(uuid()) @db.Uuid
  agentId         String             @db.Uuid
  question        String             @db.Text
  evalRunId       String?            @db.Uuid
  suggestedAnswer String?            @db.Text
  status          KnowledgeGapStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([agentId], map: "IX_KnowledgeGap_agentId")
  @@index([status], map: "IX_KnowledgeGap_status")
  @@index([agentId, status, createdAt(sort: Desc)], map: "IX_KnowledgeGap_agentId_status_createdAt")
}

/// Semantic clusters of similar user questions (Phase 3 — HDBSCAN on MessageEmbedding).
model KnowledgeGapCluster {
  id                String   @id(map: "PK_KnowledgeGapCluster") @default(uuid()) @db.Uuid
  agentId           String   @db.Uuid
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  canonicalQuestion String   @db.Text
  frequency         Int
  messageIds        String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agentId], map: "IX_KnowledgeGapCluster_agentId")
}

model PlatformGapCandidate {
  id             String            @id(map: "PK_PlatformGapCandidate") @default(cuid())
  industry       IndustryType
  question       String            @db.Text
  /// Normalised fingerprint used for k-anonymity grouping (never stores org IDs).
  questionKey    String?           @db.VarChar(512)
  frequency      Int               @default(1)
  /// Distinct consenting orgs that contributed — count only, never IDs.
  orgSampleSize  Int               @default(0)
  status         PlatformGapStatus @default(PENDING)
  requiresReview Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([industry, questionKey], map: "UQ_PlatformGapCandidate_industry_questionKey")
  @@index([industry], map: "IX_PlatformGapCandidate_industry")
  @@index([status], map: "IX_PlatformGapCandidate_status")
}

/// Anonymised Human Desk resolution motions for runbook reinforcement.
/// No orgId, visitorId, or transcript content — Recital 26 anonymised artifact.
model RunbookSignal {
  id                 String       @id(map: "PK_RunbookSignal") @default(uuid()) @db.Uuid
  vertical           IndustryType
  escalationReason   String       @db.VarChar(128)
  resolutionMotion   String[]     @default([])
  turnCount          Int          @default(0)
  firstReplyResolved Boolean      @default(false)
  createdAt          DateTime     @default(now())

  @@index([vertical, escalationReason], map: "IX_RunbookSignal_vertical_reason")
  @@index([createdAt], map: "IX_RunbookSignal_createdAt")
}

/// Aggregate skill / gap failure statistics across consenting orgs (no org IDs).
model SkillPerformanceScore {
  id            String       @id(map: "PK_SkillPerformanceScore") @default(uuid()) @db.Uuid
  vertical      IndustryType
  failureKey    String       @db.VarChar(255)
  failureCount  Int          @default(0)
  orgSampleSize Int          @default(0)
  windowStart   DateTime
  windowEnd     DateTime
  updatedAt     DateTime     @updatedAt

  @@unique([vertical, failureKey, windowStart], map: "UQ_SkillPerformanceScore_window")
  @@index([vertical], map: "IX_SkillPerformanceScore_vertical")
}

model SupportTicket {
  id             String                 @id(map: "PK_SupportTicket") @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  title          String                 @db.VarChar(255)
  body           String                 @db.VarChar(8000)
  contextTab     String                 @db.VarChar(128)
  contextFeature String?                @db.VarChar(255)
  screenshotPath String                 @db.VarChar(2048)
  status         SupportTicketStatus    @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       SupportTicketMessage[]

  @@index([userId], map: "IX_SupportTicket_userId")
  @@index([status], map: "IX_SupportTicket_status")
}

model SupportTicketMessage {
  id        String        @id(map: "PK_SupportTicketMessage") @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  userId    String        @db.Uuid
  body      String        @db.VarChar(8000)
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "IX_SupportTicketMessage_ticketId")
}

model VisitorMetadata {
  id             String       @id(map: "PK_VisitorMetadata") @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  visitorId      String       @db.VarChar(255)
  firstName      String?      @db.VarChar(128)
  lastName       String?      @db.VarChar(128)
  email          String?      @db.VarChar(255)
  company        String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, visitorId], map: "UQ_VisitorMetadata_org_visitor")
  @@index([organizationId], map: "IX_VisitorMetadata_organizationId")
}

// ---- Desk Intelligence Framework ---- //

enum EscalationMode {
  LIVE           @map("live")
  PRIORITY       @map("priority")
  STANDARD       @map("standard")
  SELF_RESOLVING @map("selfResolving")
}

model TeamMemberProfile {
  id             String       @id(map: "PK_TeamMemberProfile") @default(uuid()) @db.Uuid
  userId         String       @unique @db.Uuid
  organizationId String       @db.Uuid
  role           String       @db.VarChar(128)
  knowledgeAreas String[]     @default([])
  maxConcurrent  Int          @default(5)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_TeamMemberProfile_organizationId")
}

enum RunbookReviewStatus {
  PENDING_REVIEW @map("pendingReview")
  APPROVED       @map("approved")
}

model Runbook {
  id              String              @id(map: "PK_Runbook") @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  agentId         String              @db.Uuid
  title           String              @db.VarChar(255)
  description     String?             @db.Text
  steps           Json                @default("[]")
  triggerTopics   String[]            @default([])
  sourceTicketId  String?             @db.Uuid
  isAutoGenerated Boolean             @default(false)
  reviewStatus    RunbookReviewStatus @default(APPROVED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agent           Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  handoffTickets  HandoffTicket[]

  @@index([organizationId], map: "IX_Runbook_organizationId")
  @@index([agentId], map: "IX_Runbook_agentId")
}

model EscalationPolicy {
  id                    String               @id(map: "PK_EscalationPolicy") @default(uuid()) @db.Uuid
  organizationId        String               @db.Uuid
  agentId               String               @db.Uuid
  name                  String               @db.VarChar(255)
  urgencyLevel          HandoffTicketUrgency
  mode                  EscalationMode       @default(STANDARD)
  slaMinutes            Int?
  routeToKnowledgeAreas String[]             @default([])
  isDefault             Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agent                 Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_EscalationPolicy_organizationId")
  @@index([agentId], map: "IX_EscalationPolicy_agentId")
}

model ResolutionCluster {
  id               String          @id(map: "PK_ResolutionCluster") @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  title            String          @db.VarChar(255)
  pattern          String          @db.VarChar(255)
  issueType        String          @default("general") @db.VarChar(128)
  description      String?         @db.Text
  topicEmbedding   String?         @db.Text
  templateResponse String          @db.Text
  ticketCount      Int             @default(0)
  successRate      Float           @default(0)
  lastUpdatedAt    DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entries          ClusterEntry[]
  handoffTickets   HandoffTicket[]

  @@index([organizationId], map: "IX_ResolutionCluster_organizationId")
}

model ClusterEntry {
  id            String            @id(map: "PK_ClusterEntry") @default(uuid()) @db.Uuid
  clusterId     String            @db.Uuid
  ticketId      String            @db.Uuid
  resolution    String            @db.Text
  wasSuccessful Boolean           @default(true)
  createdAt     DateTime          @default(now())
  cluster       ResolutionCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ticket        HandoffTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clusterId], map: "IX_ClusterEntry_clusterId")
  @@index([ticketId], map: "IX_ClusterEntry_ticketId")
}
