enum MailProvider {
  GMAIL     @map("gmail")
  MICROSOFT @map("microsoft")
  IMAP      @map("imap")
}

enum MailConnectionStatus {
  ACTIVE       @map("active")
  NEEDS_REAUTH @map("needsReauth")
  DISCONNECTED @map("disconnected")
  ERROR        @map("error")
}

enum MailThreadStatus {
  OPEN     @map("open")
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  SNOOZED  @map("snoozed")
}

enum MailMessageDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")
}

enum MailThreadFolder {
  INBOX @map("inbox")
  DRAFT @map("draft")
  SENT  @map("sent")
  SPAM  @map("spam")
  TRASH @map("trash")
}

enum MailTrashRetention {
  WEEK         @map("week")
  MONTH        @map("month")
  THREE_MONTHS @map("three_months")
}

enum MailAssigneeKind {
  UNASSIGNED @map("unassigned")
  HUMAN      @map("human")
  COMPANION  @map("companion")
}

enum MailCompanionPolicy {
  DRAFT  @map("draft")
  ASSIGN @map("assign")
  SEND   @map("send")
}

/// Org-level mail host connection (IMAP or OAuth). Optional — orgs can skip Inbox entirely.
model MailboxConnection {
  id                String               @id(map: "PK_MailboxConnection") @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  provider          MailProvider
  /// Curated preset id from `MAIL_PROVIDERS` (e.g. zoho, fastmail). Null for legacy rows.
  providerPresetId  String?              @db.VarChar(64)
  email             String               @db.VarChar(255)
  status            MailConnectionStatus @default(ACTIVE)
  externalAccountId String?              @db.VarChar(255)
  /// Encrypted OAuth access token (Gmail / Microsoft).
  accessToken       String?              @db.Text
  /// Encrypted OAuth refresh token.
  refreshToken      String?              @db.Text
  scopes            String?              @db.Text
  tokenExpiresAt    DateTime?
  /// Encrypted IMAP host / credentials (provider = IMAP).
  imapHost          String?              @db.Text
  imapPort          Int?
  imapUser          String?              @db.Text
  imapPassword      String?              @db.Text
  imapTls           Boolean              @default(true)
  /// Encrypted SMTP host / credentials for outbound.
  smtpHost          String?              @db.Text
  smtpPort          Int?
  smtpUser          String?              @db.Text
  smtpPassword      String?              @db.Text
  smtpTls           Boolean              @default(true)
  lastSyncedAt      DateTime?
  lastError         String?              @db.VarChar(2000)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  aliases           MailAlias[]

  @@unique([organizationId, email], map: "UQ_MailboxConnection_org_email")
  @@index([organizationId], map: "IX_MailboxConnection_organizationId")
  @@index([organizationId, provider], map: "IX_MailboxConnection_org_provider")
}

/// Support address handled in Humaner. Redirect aliases are free; connected mailboxes count toward plan inbox allotment.
model MailAlias {
  id             String            @id(map: "PK_MailAlias") @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connectionId   String            @db.Uuid
  connection     MailboxConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  address        String            @db.VarChar(255)
  displayName    String?              @db.VarChar(255)
  enabled        Boolean              @default(true)
  /// Companion may draft for approval, assign itself, or send on this alias.
  companionPolicy MailCompanionPolicy @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        MailAliasMember[]
  threads        MailThread[]
  tags           MailTag[]

  @@unique([organizationId, address], map: "UQ_MailAlias_org_address")
  @@index([connectionId], map: "IX_MailAlias_connectionId")
  @@index([organizationId], map: "IX_MailAlias_organizationId")
}

model MailAliasMember {
  id        String    @id(map: "PK_MailAliasMember") @default(uuid()) @db.Uuid
  aliasId   String    @db.Uuid
  alias     MailAlias @relation(fields: [aliasId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime  @default(now())

  @@unique([aliasId, userId], map: "UQ_MailAliasMember_alias_user")
  @@index([userId], map: "IX_MailAliasMember_userId")
}

model MailThread {
  id               String           @id(map: "PK_MailThread") @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aliasId          String           @db.Uuid
  alias            MailAlias        @relation(fields: [aliasId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  providerThreadId String           @db.VarChar(512)
  subject          String           @db.VarChar(998)
  status           MailThreadStatus @default(OPEN)
  isUnread         Boolean          @default(true)
  folder           MailThreadFolder @default(INBOX)
  archivedAt       DateTime?
  /// Set when the thread is moved to Trash; cleared when it leaves.
  trashedAt        DateTime?
  assigneeKind     MailAssigneeKind @default(UNASSIGNED)
  assigneeId       String?          @db.Uuid
  assignee         User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Shared human-only note draft — one per thread, never sent by Companion.
  sharedNoteDraft           String?   @db.Text
  sharedNoteDraftUpdatedAt  DateTime?
  sharedNoteDraftAuthorId   String?   @db.Uuid
  handoffTicketId  String?          @db.Uuid
  handoffTicket    HandoffTicket?   @relation(fields: [handoffTicketId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastMessageAt    DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         MailMessage[]
  notes            MailThreadNote[]
  tags             MailThreadTag[]

  @@unique([aliasId, providerThreadId], map: "UQ_MailThread_alias_providerThread")
  @@index([organizationId, status, lastMessageAt], map: "IX_MailThread_org_status_last")
  @@index([organizationId, isUnread, archivedAt], map: "IX_MailThread_org_unread_archived")
  @@index([organizationId, folder, archivedAt], map: "IX_MailThread_org_folder_archived")
  @@index([organizationId, folder, trashedAt], map: "IX_MailThread_org_folder_trashedAt")
  @@index([assigneeId], map: "IX_MailThread_assigneeId")
  @@index([assigneeKind], map: "IX_MailThread_assigneeKind")
  @@index([handoffTicketId], map: "IX_MailThread_handoffTicketId")
}

/// Org-defined colored labels for collaborative mail threads.
/// `aliasId` null = available on all aliases; set = scoped to one inbox.
model MailTag {
  id             String          @id(map: "PK_MailTag") @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Null = on all aliases; otherwise only that inbox.
  aliasId        String?         @db.Uuid
  alias          MailAlias?      @relation(fields: [aliasId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String          @db.VarChar(64)
  /// Hex color (#RRGGBB) used for the unread/read circle on thread rows.
  color          String          @db.VarChar(7)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  threads        MailThreadTag[]

  @@index([organizationId], map: "IX_MailTag_organizationId")
  @@index([organizationId, aliasId], map: "IX_MailTag_organizationId_aliasId")
}

/// Workspace block list — inbound mail from these addresses is filed to Spam.
model MailBlockedSender {
  id             String       @id(map: "PK_MailBlockedSender") @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  email          String       @db.VarChar(255)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email], map: "UQ_MailBlockedSender_org_email")
  @@index([organizationId], map: "IX_MailBlockedSender_organizationId")
}

model MailThreadTag {
  id        String     @id(map: "PK_MailThreadTag") @default(uuid()) @db.Uuid
  threadId  String     @db.Uuid
  thread    MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tagId     String     @db.Uuid
  tag       MailTag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime   @default(now())

  @@unique([threadId, tagId], map: "UQ_MailThreadTag_thread_tag")
  @@index([tagId], map: "IX_MailThreadTag_tagId")
}

model MailMessage {
  id                String               @id(map: "PK_MailMessage") @default(uuid()) @db.Uuid
  threadId          String               @db.Uuid
  thread            MailThread           @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  providerMessageId String               @db.VarChar(512)
  direction         MailMessageDirection
  fromAddress       String               @db.VarChar(255)
  toAddresses       String[]
  ccAddresses       String[]             @default([])
  bodyText          String?              @db.Text
  bodyHtml          String?              @db.Text
  sentAt            DateTime
  createdAt         DateTime             @default(now())

  @@unique([threadId, providerMessageId], map: "UQ_MailMessage_thread_providerMessage")
  @@index([threadId, sentAt], map: "IX_MailMessage_thread_sentAt")
}

/// Workspace-wide team message — visible to every member.
model TeamMessage {
  id             String       @id(map: "PK_TeamMessage") @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId       String       @db.Uuid
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  body           String       @db.Text
  attachments    Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt], map: "IX_TeamMessage_organizationId_createdAt")
  @@index([authorId], map: "IX_TeamMessage_authorId")
}

/// Internal-only collaboration note — never sent to the customer.
model MailThreadNote {
  id        String     @id(map: "PK_MailThreadNote") @default(uuid()) @db.Uuid
  threadId  String     @db.Uuid
  thread    MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId  String     @db.Uuid
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([threadId], map: "IX_MailThreadNote_threadId")
  @@index([authorId], map: "IX_MailThreadNote_authorId")
}

model KnowledgeSourceDraft {
  id               String      @id(map: "PK_KnowledgeSourceDraft") @default(uuid()) @db.Uuid
  agentId          String      @db.Uuid
  agent            Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title            String      @db.VarChar(255)
  content          String      @db.Text
  sourceMessageIds String[]
  status           DraftStatus @default(PENDING_REVIEW)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([agentId], map: "IX_KnowledgeSourceDraft_agentId")
}

// ---- Agent Training & Intelligence ---- //

enum PlatformChunkSource {
  SYNTHETIC    @map("synthetic")
  CURATED_REAL @map("curatedReal")
}

model PlatformChunk {
  id           String              @id(map: "PK_PlatformChunk") @default(cuid())
  industry     IndustryType
  question     String              @db.Text
  content      String              @db.Text
  tokenCount   Int
  source       PlatformChunkSource @default(SYNTHETIC)
  qualityScore Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([industry], map: "IX_PlatformChunk_industry")
}

model VerticalRelease {
  id             String       @id(map: "PK_VerticalRelease") @default(cuid())
  industry       IndustryType
  version        String
  certified      Boolean      @default(false)
  certificate    Json
  personaPreset  Json
  intentTaxonomy Json
  routingConfig  Json
  chunkCount     Int          @default(0)
  promotedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([industry, version], map: "UQ_VerticalRelease_industry_version")
  @@index([industry], map: "IX_VerticalRelease_industry")
}

/// Aggregate skill / gap failure statistics across consenting orgs (no org IDs).
model SkillPerformanceScore {
  id            String       @id(map: "PK_SkillPerformanceScore") @default(uuid()) @db.Uuid
  vertical      IndustryType
  failureKey    String       @db.VarChar(255)
  failureCount  Int          @default(0)
  orgSampleSize Int          @default(0)
  windowStart   DateTime
  windowEnd     DateTime
  updatedAt     DateTime     @updatedAt

  @@unique([vertical, failureKey, windowStart], map: "UQ_SkillPerformanceScore_window")
  @@index([vertical], map: "IX_SkillPerformanceScore_vertical")
}

model VisitorMetadata {
  id             String       @id(map: "PK_VisitorMetadata") @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  visitorId      String       @db.VarChar(255)
  firstName      String?      @db.VarChar(128)
  lastName       String?      @db.VarChar(128)
  email          String?      @db.VarChar(255)
  company        String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, visitorId], map: "UQ_VisitorMetadata_org_visitor")
  @@index([organizationId], map: "IX_VisitorMetadata_organizationId")
}

// ---- Desk Intelligence Framework ---- //

enum EscalationMode {
  LIVE           @map("live")
  PRIORITY       @map("priority")
  STANDARD       @map("standard")
  SELF_RESOLVING @map("selfResolving")
}

model TeamMemberProfile {
  id             String       @id(map: "PK_TeamMemberProfile") @default(uuid()) @db.Uuid
  userId         String       @unique @db.Uuid
  organizationId String       @db.Uuid
  role           String       @db.VarChar(128)
  knowledgeAreas String[]     @default([])
  maxConcurrent  Int          @default(5)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_TeamMemberProfile_organizationId")
}

model EscalationPolicy {
  id                    String               @id(map: "PK_EscalationPolicy") @default(uuid()) @db.Uuid
  organizationId        String               @db.Uuid
  agentId               String               @db.Uuid
  name                  String               @db.VarChar(255)
  urgencyLevel          HandoffTicketUrgency
  mode                  EscalationMode       @default(STANDARD)
  slaMinutes            Int?
  routeToKnowledgeAreas String[]             @default([])
  isDefault             Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agent                 Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId], map: "IX_EscalationPolicy_organizationId")
  @@index([agentId], map: "IX_EscalationPolicy_agentId")
}
