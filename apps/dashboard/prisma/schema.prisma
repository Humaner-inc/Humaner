  HIGH   @map("high")
}

enum HandoffTicketSource {
  WIDGET @map("widget")
  API    @map("api")
  EMAIL  @map("email")
}

enum HandoffRoutedTo {
  AI    @map("ai")
  HUMAN @map("human")
}

enum AgentLoopMode {
  AUTO_SOLVE @map("autoSolve")
  APPROVAL   @map("approval")
}

enum LoopStatus {
  SOLVING     @map("solving")
  DRAFT_READY @map("draftReady")
  APPROVED    @map("approved")
  REJECTED    @map("rejected")
  FAILED      @map("failed")
}

/// A handoff ticket: routed to Agent Desk or Human Desk after the chat agent
/// could not resolve. Created with an AI summary plus transcript.
model HandoffTicket {
  id                 String               @id(map: "PK_HandoffTicket") @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agentId            String               @db.Uuid
  agent              Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversationId     String?              @db.Uuid
  conversation       Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Org-scoped human-readable reference (e.g. #00042). Unique per organization.
  ticketNumber       Int
  visitorId          String?              @db.VarChar(255)
  visitorEmail       String?              @db.VarChar(255)
  visitorFirstName   String?              @db.VarChar(128)
  visitorLastName    String?              @db.VarChar(128)
  visitorCompany     String?              @db.VarChar(255)
  visitorLeftAt      DateTime?
  subject            String               @db.VarChar(255)
  summary            String               @db.Text
  whySummary         String?              @db.Text
  howSummary         String?              @db.Text
  transcript         String               @db.Text
  note               String?              @db.Text
  source             HandoffTicketSource  @default(WIDGET)
  status             HandoffTicketStatus  @default(OPEN)
  urgency            HandoffTicketUrgency @default(MEDIUM)
  assigneeId         String?              @db.Uuid
  assignee           User?                @relation(fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedAt         DateTime?
  routedTo           HandoffRoutedTo?
  clusterId          String?              @db.Uuid
  cluster            ResolutionCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  runbookId          String?              @db.Uuid
  runbook            Runbook?             @relation(fields: [runbookId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedAt         DateTime?
  /// "human" or "ai" — matches HandoffRoutedTo.
  resolvedBy         String?              @db.VarChar(8)
  /// Display name of the resolver (team member name or "Agent Desk").
  resolvedByName     String?              @db.VarChar(255)
  resolutionPattern  String?              @db.VarChar(255)
  issueType          String?              @db.VarChar(128)
  resolutionSolution String?              @db.Text
  /// Agent Loops run state for tickets routed to Agent Desk.
  loopStatus         LoopStatus?
  /// Draft solution produced by an Agent Loop (awaiting approval or sent).
  draftSolution      String?              @db.Text
  loopSolvedAt       DateTime?
  loopError          String?              @db.VarChar(512)
  liveChatTimedOut   Boolean              @default(false)
  clusterEntries     ClusterEntry[]
  mailThreads        MailThread[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([organizationId, ticketNumber], map: "UQ_HandoffTicket_organizationId_ticketNumber")
  @@index([organizationId], map: "IX_HandoffTicket_organizationId")
  @@index([agentId], map: "IX_HandoffTicket_agentId")
  @@index([status], map: "IX_HandoffTicket_status")
  @@index([assigneeId], map: "IX_HandoffTicket_assigneeId")
  @@index([routedTo], map: "IX_HandoffTicket_routedTo")
  @@index([organizationId, status, updatedAt], map: "IX_HandoffTicket_org_status_updated")
  @@index([organizationId, status, createdAt(sort: Desc)], map: "IX_HandoffTicket_org_status_createdAt")
  @@index([organizationId, loopStatus], map: "IX_HandoffTicket_org_loopStatus")
}

// ---- Collaborative Inbox (optional mailbox) ---- //

enum MailProvider {
  GMAIL     @map("gmail")
  MICROSOFT @map("microsoft")
  IMAP      @map("imap")
}

enum MailConnectionStatus {
  ACTIVE       @map("active")
  NEEDS_REAUTH @map("needsReauth")
  DISCONNECTED @map("disconnected")
  ERROR        @map("error")
}

enum MailThreadStatus {
  OPEN     @map("open")
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  SNOOZED  @map("snoozed")
}

enum MailMessageDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")
}

/// Org-level mail host connection (IMAP or OAuth). Optional — orgs can skip Inbox entirely.
model MailboxConnection {
  id                String               @id(map: "PK_MailboxConnection") @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  provider          MailProvider
  /// Curated preset id from `MAIL_PROVIDERS` (e.g. zoho, fastmail). Null for legacy rows.
  providerPresetId  String?              @db.VarChar(64)
  email             String               @db.VarChar(255)
  status            MailConnectionStatus @default(ACTIVE)
  externalAccountId String?              @db.VarChar(255)
  /// Encrypted OAuth access token (Gmail / Microsoft).
  accessToken       String?              @db.Text
  /// Encrypted OAuth refresh token.
  refreshToken      String?              @db.Text
  scopes            String?              @db.Text
  tokenExpiresAt    DateTime?
  /// Encrypted IMAP host / credentials (provider = IMAP).
  imapHost          String?              @db.Text
  imapPort          Int?
  imapUser          String?              @db.Text
  imapPassword      String?              @db.Text
  imapTls           Boolean              @default(true)
  /// Encrypted SMTP host / credentials for outbound.
  smtpHost          String?              @db.Text
  smtpPort          Int?
  smtpUser          String?              @db.Text
  smtpPassword      String?              @db.Text
  smtpTls           Boolean              @default(true)
  lastSyncedAt      DateTime?
  lastError         String?              @db.VarChar(2000)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  aliases           MailAlias[]

  @@unique([organizationId, email], map: "UQ_MailboxConnection_org_email")
  @@index([organizationId], map: "IX_MailboxConnection_organizationId")
  @@index([organizationId, provider], map: "IX_MailboxConnection_org_provider")
}

/// Support address handled in Humaner. Redirect aliases are free; connected mailboxes count toward plan inbox allotment.
