  @@index([agentId, createdAt(sort: Desc)], map: "IX_IntelligenceRequestLog_agentId_createdAt")
  @@index([organizationId, createdAt(sort: Desc)], map: "IX_IntelligenceRequestLog_organizationId_createdAt")
}

