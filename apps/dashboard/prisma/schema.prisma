/// 30-day rolling cache of user-message vectors for content-gap clustering.
/// `embedding` is pgvector — Prisma cannot map it, so it is read/written with raw SQL.
/// One-off questions stay hash-only until they repeat or meaning-match inside the window.
model MessageEmbedding {
  messageId   String                       @id(map: "PK_MessageEmbedding") @db.Uuid
  message     Message                      @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agentId     String                       @db.Uuid
  agent       Agent                        @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentHash String                       @db.VarChar(64)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  @@index([agentId, contentHash, createdAt], map: "IX_MessageEmbedding_agent_hash_createdAt")
  @@index([agentId, createdAt], map: "IX_MessageEmbedding_agent_createdAt")
  @@index([createdAt], map: "IX_MessageEmbedding_createdAt")
}

