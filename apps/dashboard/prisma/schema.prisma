/// One row per Intelligence REST call. Powers the Custom implementation log —
/// hosted chat traffic is already visible through Conversation/Message.
model IntelligenceRequestLog {
  id             String   @id(map: "PK_IntelligenceRequestLog") @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  agentId        String   @db.Uuid
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Resolved catalog tool, e.g. search_knowledge or create_ticket.
  tool           String   @db.VarChar(64)
