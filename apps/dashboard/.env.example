# HUMANER SELF-HOST
NEXT_PUBLIC_DEPLOYMENT_MODE=oss
NEXT_PUBLIC_APP_URL=http://localhost:3001

# DATABASE (PostgreSQL 16+ with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/humaner
DIRECT_URL=postgresql://user:password@localhost:5432/humaner

# AUTH
# Generate with: openssl rand -base64 32. Also encrypts stored IMAP credentials.
AUTH_SECRET=
# Previous AUTH_SECRET, kept until every encrypted row has been rewritten.
# AUTH_SECRET_PREVIOUS=
AUTH_TRUST_HOST=true

# Optional Google login. Redirect: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# CRON
# Bearer secret for /api/cron/purge-messages. The route rejects every request
# while this is unset.
# CRON_SECRET=

# EMAIL (sign-up verification OTP is emailed)
EMAIL_SENDER="Humaner <onboarding@example.com>"
EMAIL_MAILER=NodeMailer
# EMAIL_MAILER=Resend
# EMAIL_RESEND_API_KEY=

# NodeMailer / SMTP
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=

# Local smoke tests only: prints sign-up OTPs to the server console.
# Never enable on a deployment that serves real users.
# SELF_HOST_LOG_VERIFICATION=true

# OPTIONAL LLM (ANTHROPIC_API_KEY works as an alias)
# CLAUDE_API_KEY=

# IMAP IDLE worker: required for live mail (not serverless).
# Docker Compose starts it as the `imap-idle` service. Local: see SELFHOST.md.
IMAP_IDLE_ENABLED=true
# IMAP_IDLE_MAX_CONNECTIONS=50
# IMAP_IDLE_RECONNECT_MS=5000

# Optional S3-compatible object storage for mail attachments.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# MAIL_STORAGE_BUCKET=mail
